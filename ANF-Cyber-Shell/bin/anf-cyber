#!/usr/bin/env zsh
# ==============================================================================
# ANF CYBER SHELL — Enterprise Launcher
# Entry point CLI: `anf-cyber <cmd> [args...]` menjalankan satu command dari
# shell, atau `anf-cyber` (tanpa argumen) memuat shell interaktif lengkap
# (ZLE popup + banner).
#
# Lokasi script inti: $(dirname $0)/../code/anf_cyber_shell.zsh
# Konfigurasi:        $ANF_CONFIG  (default $HOME/.config/anf-cyber/anfrc)
# ==============================================================================
set -u

# --- Resolve lokasi script inti (dukung symlink + multi-lokasi) ---------------
_SELF="${(%):-%x}"
_SELF="$(readlink -f "$_SELF" 2>/dev/null || print -r -- "$_SELF")"
_ANF_DIR="${_SELF:h}"

# Prioritas lokasi script inti:
#  1. env ANF_LIB eksplisit
#  2. relatif ke launcher: <bindir>/../lib/anf-cyber/anf_cyber_shell.zsh (install)
#  3. lokasi project (repo source)
_ANF_LIB=""
for cand in \
    "${ANF_LIB:-}" \
    "${_ANF_DIR:h}/lib/anf-cyber/anf_cyber_shell.zsh" \
    "${_ANF_DIR:h}/code/anf_cyber_shell.zsh" \
    "${_ANF_DIR}/../code/anf_cyber_shell.zsh" \
    "$HOME/Documents/ANF-Cyber-Shell/code/anf_cyber_shell.zsh"; do
    if [[ -n "$cand" && -f "$cand" ]]; then
        _ANF_LIB="$cand"
        break
    fi
done

if [[ -z "$_ANF_LIB" ]]; then
    print -u2 "ANF-CYBER: script inti tidak ditemukan. Set ANF_LIB=<path> atau instal dengan install.sh."
    return 1 2>/dev/null || exit 1
fi

# --- Baca konfigurasi (jika ada) ----------------------------------------------
_ANF_CFG="${ANF_CONFIG:-$HOME/.config/anf-cyber/anfrc}"
[[ -f "$_ANF_CFG" ]] && source "$_ANF_CFG"

# --- Load library -------------------------------------------------------------
source "$_ANF_LIB"

# --- Dispatch -----------------------------------------------------------------
if (( $# == 0 )); then
    if [[ -o interactive ]]; then
        return 0 2>/dev/null  # sudah ter-source di environment parent
    fi
    # Shell interaktif persisten: source lib via ZDOTDIR rc, lalu exec zsh -i.
    # (zsh -i -c "..." akan langsung exit setelah command; harus pakai rc.)
    _anf_tmp_rc="$(mktemp -d)"
    print -r -- "source '$_ANF_LIB'" > "$_anf_tmp_rc/.zshrc"
    ZDOTDIR="$_anf_tmp_rc" exec zsh -i
    exit 0
fi

_cmd="$1"; shift
_func="anf_${_cmd//-/_}"
if (( ${+functions[$_func]} )); then
    "$_func" "$@"
    exit $?
fi

print -u2 "ANF-CYBER: command tidak dikenal: /$_cmd"
print -u2 "Coba 'anf-cyber help' untuk daftar command."
exit 1
